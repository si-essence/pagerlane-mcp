# Sent only as the X-API-KEY header. Never printed. At least 8 characters.
KEEP_API_KEY=

# Keep API origin, optional path, no userinfo, query, or hash.
# Examples: https://api.keephq.dev  http://localhost:8080
KEEP_API_URL=http://localhost:8080

# Contact embedded in the User-Agent. Must not be the API key.
KEEP_CONTACT=you@example.com

# Local sliding window. Cache hits do not spend it.
KEEP_PER_MINUTE=30

# Cache TTL in seconds for reads. 0 disables the cache. Writes are never cached.
KEEP_CACHE_TTL_SEC=60

# Upstream timeout in milliseconds.
KEEP_TIMEOUT_MS=20000

# stdio (default) or http. --http on the command line forces http.
MCP_TRANSPORT=stdio
PORT=3000
